---
import "../styles/Footer.css";
---

<footer class="footer">

    <div class="container">

        <div class="footer-wrapper">

            <div class="footer-brand">

                <img
                    src="/images/Logo-white.svg"
                    alt="APF"
                    class="footer-logo"
                />

                <p class="footer-description">
                    ผู้ให้บริการ Fulfillment
                    <br />
                    และระบบคลังสินค้าอัจฉริยะครบวงจร
                </p>

            </div>

            <div class="footer-column">

                <h4>บริการของเรา</h4>

                <a href="/service-detail#b2b">B2B Fulfillment</a>
                <a href="/service-detail#warehouse">Warehouse Management</a>
                <a href="/service-detail#b2c">B2C Fulfillment</a>
                <a href="/service-detail#transportation">Transportation Services</a>

            </div>

            <div class="footer-column">

                <h4>บริษัท</h4>

                <a href="/about">เกี่ยวกับเรา</a>
                <a href="#">ข่าวสาร</a>
                <a href="#">ร่วมงานกับเรา</a>

            </div>

            <div class="footer-column footer-contact">

                <h4>ติดต่อเรา</h4>

                <a href="tel:027845888" class="footer-contact-item">

                    <img
                        src="/images/phone-call.png"
                        alt="Phone"
                    />

                    <span>0-2784-5888</span>

                </a>

                <a href="mailto:sales@apf.co.th" class="footer-contact-item">

                    <img
                        src="/images/mail.png"
                        alt="Email"
                    />

                    <span>sales@apf.co.th</span>

                </a>

                <div class="footer-contact-item">

                    <img
                        src="/images/pin.png"
                        alt="Location"
                    />

                    <span>
                        30/88 Moo 1 Chetsadawithi Road,
                        <br />
                        Khokkam sub-district, Muang Samut Sakhon district,
                        <br />
                        Samut Sakhon Province 74000
                    </span>

                </div>

            </div>
        </div>

        <div class="footer-bottom">

            <span>© 2026 ALPHA PRIME FULFILLMENT CO., LTD. All rights reserved.</span>
            <a href="#">นโยบายความเป็นส่วนตัว</a>

        </div>

    </div>

</footer>
