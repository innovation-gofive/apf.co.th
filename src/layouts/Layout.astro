---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const {
  showChrome = true,
  hideChromeInitially = false,
  heroImage,
  heroImageSrcset,
  heroImageSizes = "100vw",
  title = "APF",
  description,
} = Astro.props;
---

<!doctype html>
<html lang="th">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- WordPress blocks image requests that originate from a different domain. -->
    <meta name="referrer" content="no-referrer" />

    <!-- Reuse early connections for the site font and WordPress-hosted media. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cms.apf.co.th" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" />

    {heroImage && <link rel="preload" as="image" href={heroImage} imagesrcset={heroImageSrcset} imagesizes={heroImageSrcset ? heroImageSizes : undefined} fetchpriority="high" />}

    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
</head>

<body>

    {showChrome && <div data-site-chrome hidden={hideChromeInitially}><Navbar /></div>}

    <main>

        <slot />

    </main>

    {showChrome && <div data-site-chrome hidden={hideChromeInitially}><Footer /></div>}

</body>

</html>
