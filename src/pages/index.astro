---
import Layout from "../layouts/Layout.astro";
import Home from "../sections/Home.astro";
import {
    fetchAPI,
    getMedia,
    getMediaList,
    getPageBySlug
} from "../services/wordpress";


const [home, globalCTA] = await Promise.all([
    fetchAPI("/pages/9"),
    getPageBySlug("global-cta"),
]);
const acf = home.acf;

// All media groups are independent, so fetch them in parallel instead of
// waiting for each WordPress request group to finish one by one.
const [
    background,
    featureIcons,
    serviceIcons,
    operatingIcons,
    whyChooseImage,
    whyChooseIcons,
    technologyImages,
    platformIcons,
    smartPlatformBackground,
    smartPlatformIcons,
    warehouseImage,
    locationImage,
    locationIcons,
    clientLogos,
] = await Promise.all([
    getMedia(acf.background_image),
    getMediaList([acf.features.feature_1.icon, acf.features.feature_2.icon, acf.features.feature_3.icon]),
    getMediaList([acf.service_cards.service_1.icon, acf.service_cards.service_2.icon, acf.service_cards.service_3.icon, acf.service_cards.service_4.icon]),
    getMediaList([acf.step_1.icon, acf.step_2.icon, acf.step_3.icon, acf.step_4.icon, acf.step_5.icon, acf.step_6.icon]),
    getMedia(acf.why_choose_image),
    getMediaList([acf.why_choose_feature_1.icon, acf.why_choose_feature_2.icon, acf.why_choose_feature_3.icon, acf.why_choose_feature_4.icon]),
    getMediaList([acf.technology_card_1.image, acf.technology_card_2.image, acf.technology_card_3.image, acf.technology_card_4.image]),
    getMediaList([acf.our_platform_1.icon, acf.our_platform_2.icon, acf.our_platform_3.icon, acf.our_platform_4.icon]),
    getMedia(acf.smart_platform_background),
    getMediaList([acf.feature_1.icon, acf.feature_2.icon, acf.feature_3.icon, acf.feature_4.icon]),
    getMedia(acf.warehouse_capacity.image_warehouse_capacity),
    getMedia(acf.our_location.image_our_location),
    getMediaList([acf.our_location.feature_1.icon_our_location, acf.our_location.feature_2.icon_our_location, acf.our_location.feature_3.icon_our_location]),
    getMediaList([acf.client_1, acf.client_2, acf.client_3, acf.client_4, acf.client_5, acf.client_6, acf.client_8]),
]);

const clients = {
    title: home.acf.our_clients_title,
    description: home.acf.our_clients_description,
    logos: clientLogos,
};

const ctaBackground = await getMedia(
    globalCTA.acf.cta_background_image
);

const cta = {
    background: ctaBackground.source_url,
    descriptionTitle: globalCTA.acf.cta_description_title,
    title: globalCTA.acf.cta_title,
    description: globalCTA.acf.cta_description,
    primaryButton: globalCTA.acf.cta_primary_button,
    secondaryButton: globalCTA.acf.cta_secondary_button,
};

---

<Layout>
<Home
    home={home}
    background={background.source_url}
    featureIcons={featureIcons}
    serviceIcons={serviceIcons}
    operatingIcons={operatingIcons}
    whyChooseImage={whyChooseImage.source_url}
    whyChooseIcons={whyChooseIcons}
    technologyImages={technologyImages}
    platformIcons={platformIcons}
    smartPlatformBackground={smartPlatformBackground.source_url}
    smartPlatformIcons={smartPlatformIcons}
    warehouseImage={warehouseImage.source_url}
    locationImage={locationImage.source_url}
    locationIcons={locationIcons}
    clients={clients}
    cta={cta}
/>
</Layout>
