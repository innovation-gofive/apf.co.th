---
import Layout from "../layouts/Layout.astro";
import ServiceDetail from "../sections/ServiceDetail.astro";
import { getMediaMap, getPageBySlug } from "../services/wordpress";

const page = await getPageBySlug("service-detail");
const media = await getMediaMap(page.acf);
---

<Layout
  heroImage={media[page.acf.service_detail_hero_background_image]}
  title="รายละเอียดโซลูชัน Fulfillment สำหรับธุรกิจ B2B และ B2C | APF"
  description="ดูรายละเอียดโซลูชัน Fulfillment ของ APF สำหรับ B2B และ eCommerce ครอบคลุมการจัดการคลังสินค้า การรับและแพ็กออเดอร์ ตลอดจนการขนส่งและกระจายสินค้าถึงปลายทาง"
>
  <ServiceDetail acf={page.acf} media={media} />
</Layout>
