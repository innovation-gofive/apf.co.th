---
import Layout from "../layouts/Layout.astro";
import ServiceDetail from "../sections/ServiceDetail.astro";
import { getMediaMap, getPageBySlug } from "../services/wordpress";

const page = await getPageBySlug("service-detail");
const media = await getMediaMap(page.acf);
---

<Layout heroImage={media[page.acf.service_detail_hero_background_image]}>
  <ServiceDetail acf={page.acf} media={media} />
</Layout>
