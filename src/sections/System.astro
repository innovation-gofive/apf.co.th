---
import "../styles/System.css";
import "../styles/CTA.css";
import "../styles/TabletPortrait.css";
import WordPressImage from "../components/WordPressImage.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  system,
  heroBackground,
  platformIcons,
  platformImages,
  useCaseImages,
  useCasePartnerLogos,
  useCaseFeatureIcons,
  integrationLogos,
  cta,
} = Astro.props;

const acf = system.acf;

function splitEyebrow(title = "") {
  const [firstWord, ...remainingWords] = title.split(" ");
  return { firstWord, remainingWords: remainingWords.join(" ") };
}

function joinForcedLines(text = "") {
  return String(text)
    .split(/[\u2028\r\n]+/)
    .map((line) => line.trim())
    .join(" ")
    .replace(/Real-Time/gi, "Real\u2011Time");
}

function joinHeroLines(text = "") {
  return String(text)
    .split(/[\u2028\r\n]+/)
    .map((line) => line.trim())
    .join("")
    .replace(/([A-Za-z0-9])(?=[\u0E00-\u0E7F])/g, "$1 ")
    .replaceAll("ออเดอร์", "ออเด\u2060อร์")
    .replace(/Real-Time/gi, "Real\u2011Time");
}

const heroEyebrow = splitEyebrow(acf.system_hero_small_title);
const heroDescriptionLines = [
  "ShipX คือแพลตฟอร์มบริหารจัดการคลังสินค้า ออเดอร์ และการจัดส่งแบบครบวงจร",
  "เชื่อมต่อทุกกระบวนการทำงานแบบ Real‑time",
  "เพื่อให้ธุรกิจดำเนินงานได้อย่างมีประสิทธิภาพมากขึ้น",
];
const platformEyebrow = splitEyebrow(acf.system_platform_small_title);
const useCasesEyebrow = splitEyebrow(acf.system_use_cases_small_title);
const integrationEyebrow = splitEyebrow(acf.system_integration_small_title);

const platforms = [1, 2, 3, 4].map((number, index) => {
  const card = acf[`system_platform_card_${number}`];
  return {
    icon: platformIcons[index],
    image: platformImages[index],
    title: card?.title,
    smallTitle: card?.small_title,
    description: String(card?.description ?? "").replace(/Real-Time/gi, "Real\u2011Time"),
  };
});

const useCases = [1, 2, 3, 4].map((number, index) => {
  const card = acf[`system_use_case_${number}`];
  const images = useCaseImages.slice(index * 4, index * 4 + 4).filter(Boolean);
  const featureStart = number === 2 ? 0 : number === 4 ? 3 : -1;

  return {
    number: card?.number,
    title: card?.title,
    description: joinForcedLines(card?.description),
    images,
    features:
      featureStart < 0
        ? []
        : [1, 2, 3]
            .map((featureNumber, featureIndex) => ({
              icon: useCaseFeatureIcons[featureStart + featureIndex],
              text: card?.[`feature_item_${featureNumber}`]?.text,
            }))
            .filter((feature) => feature.text),
  };
});
---

<section class="system-hero" style={`background-image: url('${heroBackground}')`}>
  <div class="container system-hero__content">
    <p class="system-hero__eyebrow">
      <span>{heroEyebrow.firstWord}</span> {heroEyebrow.remainingWords}
    </p>
    <h1>{acf.system_hero_main_title}</h1>
    <p class="system-hero__description">{heroDescriptionLines.map((line) => <span>{line}</span>)}</p>
    <div class="system-hero__buttons">
      <a class="system-button system-button--primary" href={`${basePath}/contact#demo`}>
        {acf.system_hero_primary_button_text} 
      </a>
      <a class="system-button system-button--secondary" href={`${basePath}/contact#inquiry`}>
        {acf.system_hero_secondary_button_text} 
      </a>
    </div>
  </div>
</section>

<section class="system-section system-platform">
  <div class="container">
    <header class="system-section__heading">
      <p class="system-eyebrow">
        <span>{platformEyebrow.firstWord}</span>{" "}
        <b>{platformEyebrow.remainingWords}</b>
      </p>
      <h2>{acf.system_platform_main_title}</h2>
      <i></i>
    </header>
    <div class="platform-grid">
      {platforms.map((platform) => (
        <article class="platform-card">
          <header>
            {platform.icon && <img src={platform.icon} alt="" loading="lazy" decoding="async" />}
            <div><h3>{platform.title}</h3><p>{platform.smallTitle}</p></div>
          </header>
          {platform.image && (
            <button
              class="platform-card__image-button"
              type="button"
              data-platform-preview
              data-image={platform.image.source_url}
              data-alt={platform.title || "ภาพตัวอย่างระบบ"}
              aria-label={`ดูภาพ ${platform.title || "ระบบ"} ขนาดใหญ่`}
            >
              <WordPressImage
                class="platform-card__image"
                media={platform.image}
                alt={platform.title || ""}
                sizes="(max-width: 768px) 100vw, 25vw"
              />
            </button>
          )}
          <p class="platform-card__description">{platform.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="system-image-lightbox" data-system-lightbox hidden role="dialog" aria-modal="true" aria-label="ดูภาพขนาดใหญ่">
  <button class="system-image-lightbox__close" type="button" data-lightbox-close aria-label="ปิดภาพขนาดใหญ่">×</button>
  <img class="system-image-lightbox__image" data-lightbox-image alt="" />
</div>

<section class="system-section system-use-cases">
  <div class="container">
    <header class="system-section__heading">
      <p class="system-eyebrow">{acf.system_use_cases_small_title}</p>
      <h2>{acf.system_use_cases_main_title}</h2>
      <p>{acf.system_use_cases_description}</p>
    </header>
    <div class="use-case-list">
      {useCases.map((useCase, index) => (
        <article class:list={["use-case", `use-case--${index + 1}`]}>
          <div class="use-case__copy">
            <span class="use-case__number">{useCase.number}</span>
            <h3>{useCase.title}</h3>
            <p>{useCase.description}</p>
            {index === 0 && (
              <div class="use-case__partners">
                {useCasePartnerLogos.map((logo) => logo && <img src={logo} alt="Partner logo" loading="lazy" decoding="async" />)}
              </div>
            )}
            {useCase.features.length > 0 && (
              <div class="use-case__features">
                {useCase.features.map((feature) => (
                  <span>
                    {feature.icon && <img src={feature.icon} alt="" loading="lazy" decoding="async" />}
                    <em>{feature.text}</em>
                  </span>
                ))}
              </div>
            )}
            {index === 2 && useCase.images[0] && (
              <div class="use-case__timeline">
                <WordPressImage
                  media={useCase.images[0]}
                  alt={useCase.title || ""}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              </div>
            )}
          </div>
          <div class:list={["use-case__visual", { "use-case__visual--gallery": (index === 2 ? useCase.images.slice(1) : useCase.images).length > 1 }]}>
            {(index === 2 ? useCase.images.slice(1) : useCase.images).map((image) => (
              <WordPressImage
                media={image}
                alt={useCase.title || ""}
                sizes="(max-width: 768px) 100vw, 50vw"
              />
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const lightbox = document.querySelector<HTMLElement>("[data-system-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const lightboxClose = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
  let lastPreview: HTMLButtonElement | null = null;

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    lightboxImage?.removeAttribute("src");
    lastPreview?.focus();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-platform-preview]").forEach((preview) => {
    preview.addEventListener("click", () => {
      if (!lightbox || !lightboxImage) return;
      lastPreview = preview;
      lightboxImage.src = preview.dataset.image || "";
      lightboxImage.alt = preview.dataset.alt || "ภาพตัวอย่างระบบ";
      lightbox.hidden = false;
      lightboxClose?.focus();
    });
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
  });
</script>

<section class="system-section system-integration">
  <div class="container">
    <header class="system-section__heading">
      <p class="system-eyebrow"><span>{integrationEyebrow.firstWord}</span> {integrationEyebrow.remainingWords}</p>
      <h2>{acf.system_integration_main_title}</h2>
    </header>
    <div class="integration-logos">
      {integrationLogos.map((logo) => logo && <img src={logo} alt="Integration partner" loading="lazy" decoding="async" />)}
    </div>
  </div>
</section>

<section class="cta-banner">
  <div class="container"><div class="cta-wrapper" style={`background-image: url('${cta.background}')`}>
    <div class="cta-content"><p class="cta-eyebrow">{cta.descriptionTitle}</p><h2 class="cta-title">{cta.title}</h2><p class="cta-description">{cta.description}</p></div>
    <div class="cta-buttons"><a href={`${basePath}/contact#inquiry`}>{cta.primaryButton.cta_primary_text}</a><a href={`${basePath}/contact#demo`}>{cta.secondaryButton.cta_secondary_text}</a></div>
  </div></div>
</section>
